# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
media/
higgsfield_export/

# Virtual environments
.venv/
venv/

# UV
uv.lock

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Artifacts (production outputs)
studio_orchestrator/artifacts/

# Command Center derived state (sha cache + generated thumbnails).
# Fully regenerable from the production trees; safe to delete at any time.
visurena_command_center/.cache/

# Credentials (never commit)
credentials/
*.json.bak
token.json

# Output files
output/

# Environment
.env
.env.local

# Database (shared, not in repo)
*.db

# Gstack
.gstack/
# Book library (content + derived artifacts; DB is the catalog)
library/
views/
logs/

# Research agents occasionally drop scratch downloads in the repo root.
# Never commit them — one was a full copyrighted book text (2026-08-25).
/*.txt
/*.html
!requirements*.txt

# Research agents keep dropping scratch downloads in the repo root. A full
# copyrighted book text was nearly committed once; a Google Books error blob was
# committed today. Agents are told to use the scratch dir; this is the backstop.
/*.json
!package.json

# Rendered trailer media -- large binaries, reproducible from plan.json
library/*/trailer/*/clips/
library/*/trailer/*/work/
library/*/trailer/*/*.mp4
library/*/trailer/music/*.flac
library/*/refs/**/*.png

# Identity models fetched at run time (OpenCV zoo)
models/

# downloaded OAuth client (never commit)
client_secret*.json
# the face detector the take gate reads with (OpenCV zoo, 232 KB)
!studio/models/
!studio/models/yunet.onnx

# Command Center thumbnails kept across restarts (regenerable).
.cache/

# Audits, experiments, debates and their media stay on disk, never in git (owner 2026-10-16):
# git holds only what a fresh clone needs to run, plus the docs and images the README and wiki use.
docs/audit/

# Scratch at the repo root (2026-10-21, public-repo hygiene): btr.pdf was a saved web page
# with a .pdf name, and ffmpeg's two-pass stats land in the working directory of whatever ran it.
/*.pdf
ffmpeg2pass-*.log
ffmpeg2pass-*.log.mbtree

# SQLite scratch files
*.db-journal
*.db-wal
*.db-shm
