[
 {
  "start": 0.0,
  "end": 6.48,
  "text": "In a bright London by street, one blind and blistered door has kept a cruel secret for years.",
  "sims": {
   "narrator": 0.01,
   "richard_enfield": 0.15,
   "gabriel_john_utterson": -0.0
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 7.86,
  "end": 12.24,
  "text": "Did you ever remark that door? It is connected with a very odd story.",
  "sims": {
   "narrator": 0.11,
   "richard_enfield": 0.06,
   "gabriel_john_utterson": 0.01
  },
  "heard_as": "narrator"
 },
 {
  "start": 13.52,
  "end": 15.48,
  "text": "Indeed? And what was that?",
  "sims": {
   "narrator": -0.04,
   "richard_enfield": 0.02,
   "gabriel_john_utterson": 0.04
  },
  "heard_as": "gabriel_john_utterson"
 },
 {
  "start": 16.3,
  "end": 22.0,
  "text": "Three o'clock of a black winter morning, street after street lit up, empty as a church.",
  "sims": {
   "narrator": 0.15,
   "richard_enfield": 0.09,
   "gabriel_john_utterson": 0.02
  },
  "heard_as": "narrator"
 },
 {
  "start": 23.44,
  "end": 28.82,
  "text": "Then, I saw a little man stumping along eastward at a good walk.",
  "sims": {
   "narrator": 0.17,
   "richard_enfield": 0.12,
   "gabriel_john_utterson": 0.06
  },
  "heard_as": "narrator"
 },
 {
  "start": 30.0,
  "end": 33.9,
  "text": "And a girl of eight or ten, running as hard as she was able.",
  "sims": {
   "narrator": 0.16,
   "richard_enfield": 0.12,
   "gabriel_john_utterson": 0.07
  },
  "heard_as": "narrator"
 },
 {
  "start": 34.76,
  "end": 39.84,
  "text": "At the corner, they ran into one another, and the man trampled calmly over the child.",
  "sims": {
   "narrator": 0.14,
   "richard_enfield": 0.11,
   "gabriel_john_utterson": -0.03
  },
  "heard_as": "narrator"
 },
 {
  "start": 40.84,
  "end": 47.12,
  "text": "It was harsh to see. I took to my heels, collared my gentleman, and brought him back.",
  "sims": {
   "narrator": 0.08,
   "richard_enfield": 0.06,
   "gabriel_john_utterson": 0.03
  },
  "heard_as": "narrator"
 },
 {
  "start": 48.32,
  "end": 54.12,
  "text": "Cool as Satan, he says. No gentleman but wishes to avoid a scene. Name your figure.",
  "sims": {
   "narrator": 0.06,
   "richard_enfield": 0.03,
   "gabriel_john_utterson": -0.02
  },
  "heard_as": "narrator"
 },
 {
  "start": 54.12,
  "end": 60.3,
  "text": "We screwed him up to a hundred pounds. He whipped out a key and went in.",
  "sims": {
   "narrator": 0.13,
   "richard_enfield": 0.04,
   "gabriel_john_utterson": -0.0
  },
  "heard_as": "narrator"
 },
 {
  "start": 61.12,
  "end": 65.04,
  "text": "He brought out gold, and a check signed with a name I can't mention.",
  "sims": {
   "narrator": 0.2,
   "richard_enfield": 0.17,
   "gabriel_john_utterson": 0.08
  },
  "heard_as": "narrator"
 },
 {
  "start": 66.0,
  "end": 66.9,
  "text": "It was genuine.",
  "sims": {
   "narrator": 0.04,
   "richard_enfield": 0.08,
   "gabriel_john_utterson": -0.05
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 66.9,
  "end": 70.86,
  "text": "Enfield calls it Black Mail House.",
  "sims": {
   "narrator": 0.07,
   "richard_enfield": 0.1,
   "gabriel_john_utterson": -0.01
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 70.86,
  "end": 75.96,
  "text": "His rule, the queerer a thing looks, the less he asks.",
  "sims": {
   "narrator": 0.08,
   "richard_enfield": 0.14,
   "gabriel_john_utterson": -0.01
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 77.36,
  "end": 79.42,
  "text": "They walk on in silence.",
  "sims": {
   "narrator": 0.12,
   "richard_enfield": 0.22,
   "gabriel_john_utterson": 0.09
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 80.2,
  "end": 84.44,
  "text": "Then the lawyer breaks the rule, and demands the trampler's name.",
  "sims": {
   "narrator": 0.12,
   "richard_enfield": 0.19,
   "gabriel_john_utterson": 0.08
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 84.44,
  "end": 88.86,
  "text": "It was a man of the name of Hyde.",
  "sims": {
   "narrator": 0.21,
   "richard_enfield": 0.11,
   "gabriel_john_utterson": 0.0
  },
  "heard_as": "narrator"
 },
 {
  "start": 91.44,
  "end": 93.4,
  "text": "Enfield cannot describe him.",
  "sims": {
   "narrator": 0.02,
   "richard_enfield": 0.18,
   "gabriel_john_utterson": 0.02
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 94.4,
  "end": 95.84,
  "text": "Something detestable.",
  "sims": {
   "narrator": 0.13,
   "richard_enfield": 0.16,
   "gabriel_john_utterson": 0.06
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 96.4,
  "end": 98.2,
  "text": "A deformity he cannot place.",
  "sims": {
   "narrator": 0.14,
   "richard_enfield": 0.2,
   "gabriel_john_utterson": 0.08
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 98.96,
  "end": 101.52,
  "text": "The lawyer walks on, weighing every word.",
  "sims": {
   "narrator": 0.05,
   "richard_enfield": 0.16,
   "gabriel_john_utterson": -0.03
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 102.38,
  "end": 104.6,
  "text": "I know the other party's name already, Richard.",
  "sims": {
   "narrator": -0.07,
   "richard_enfield": 0.03,
   "gabriel_john_utterson": -0.02
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 105.24,
  "end": 106.64,
  "text": "Your tale has gone home.",
  "sims": {
   "narrator": -0.11,
   "richard_enfield": -0.02,
   "gabriel_john_utterson": -0.06
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 106.64,
  "end": 110.48,
  "text": "Enfield is certain.",
  "sims": {
   "narrator": 0.06,
   "richard_enfield": 0.14,
   "gabriel_john_utterson": 0.02
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 111.48,
  "end": 115.64,
  "text": "The fellow has the key still, and used it not a week ago.",
  "sims": {
   "narrator": 0.09,
   "richard_enfield": 0.13,
   "gabriel_john_utterson": -0.0
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 117.32,
  "end": 121.08,
  "text": "Ashamed of his long tongue, Enfield asks a bargain.",
  "sims": {
   "narrator": 0.1,
   "richard_enfield": 0.17,
   "gabriel_john_utterson": 0.02
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 121.92,
  "end": 123.2,
  "text": "Never to speak of this again.",
  "sims": {
   "narrator": 0.0,
   "richard_enfield": 0.09,
   "gabriel_john_utterson": -0.06
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 124.02,
  "end": 127.64,
  "text": "The lawyer gives his hand on it, with all his heart.",
  "sims": {
   "narrator": 0.1,
   "richard_enfield": 0.2,
   "gabriel_john_utterson": 0.03
  },
  "heard_as": "richard_enfield"
 },
 {
  "start": 127.64,
  "end": 138.52,
  "text": "Behind the lawyer, the blind door keeps its secret, as it has for a generation.",
  "sims": {
   "narrator": 0.07,
   "richard_enfield": 0.15,
   "gabriel_john_utterson": 0.01
  },
  "heard_as": "richard_enfield"
 }
]