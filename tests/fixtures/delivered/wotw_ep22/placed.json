  ],
  "lines": [
    {
      "index": 0,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Bare shelves make hunger the day's first fact.",
      "shot": 0,
      "at": 0.25,
      "seconds": 3.32
    },
    {
      "index": 1,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The empty shelves close every road back to strength.",
      "shot": 1,
      "at": 4.792,
      "seconds": 3.76
    },
    {
      "index": 2,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "I secure the door, then face the crumbs.",
      "shot": 2,
      "at": 9.583,
      "seconds": 3.4
    },
    {
      "index": 3,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "I count the days by thirst, darkness, and failing strength.",
      "shot": 3,
      "at": 14.083,
      "seconds": 4.58
    },
    {
      "index": 4,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The narrator folds beside the dresser; thirst drains his strength.",
      "shot": 4,
      "at": 19.667,
      "seconds": 4.96
    },
    {
      "index": 5,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The dark scullery narrows around my thoughts of eating.",
      "shot": 5,
      "at": 25.833,
      "seconds": 3.76
    },
    {
      "index": 6,
      "kind": "dialogue",
      "speaker": "unnamed_first_person_narrator",
      "text": "I risk the pump; black rainwater revives my throat.",
      "shot": 6,
      "at": 30.708,
      "seconds": 3.92
    },
    {
      "index": 7,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Water first. Fear can wait.",
      "shot": 7,
      "at": 35.833,
      "seconds": 2.67
    },
    {
      "index": 8,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The glass fills, and courage follows the quiet.",
      "shot": 7,
      "at": 39.203,
      "seconds": 3.59
    },
    {
      "index": 9,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The quiet after pumping gives me one small courage.",
      "shot": 8,
      "at": 44.125,
      "seconds": 3.64
    },
    {
      "index": 10,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Dreams mingle food, escape, and the curate's death.",
      "shot": 9,
      "at": 49.667,
      "seconds": 4.11
    },
    {
      "index": 11,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Thirst remains sharp.",
      "shot": 9,
      "at": 54.477,
      "seconds": 2.18
    },
    {
      "index": 12,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Red fronds seal the opening, staining daylight like blood.",
      "shot": 10,
      "at": 58.375,
      "seconds": 4.94
    },
    {
      "index": 13,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "A dog snuffles near him; its muzzle enters the gap.",
      "shot": 11,
      "at": 65.125,
      "seconds": 4.0
    },
    {
      "index": 14,
      "kind": "dialogue",
      "speaker": "unnamed_first_person_narrator",
      "text": "Good dog!",
      "shot": 12,
      "at": 71.042,
      "seconds": 1.71
    },
    {
      "index": 15,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Come nearer, good dog.",
      "shot": 12,
      "at": 73.452,
      "seconds": 2.25
    },
    {
      "index": 16,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The animal withdraws. He listens beside the weeds. He grips the rubble and starts climbing.",
      "shot": 13,
      "at": 77.542,
      "seconds": 6.61
    },
    {
      "index": 17,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Below, crows fight over bones in the emptied pit.",
      "shot": 15,
      "at": 88.0,
      "seconds": 3.82
    },
    {
      "index": 18,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "He pushes through crimson growth onto the mound.",
      "shot": 16,
      "at": 94.625,
      "seconds": 3.81
    },
    {
      "index": 19,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "An upward slope opens; he scrambles toward the summit.",
      "shot": 17,
      "at": 100.375,
      "seconds": 4.22
    },
    {
      "index": 20,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Sheen spreads around him: broken brick, red weed, dead trees, roofless rooms.",
      "shot": 18,
      "at": 106.5,
      "seconds": 6.74
    },
    {
      "index": 21,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Birds search the wreckage; a gaunt cat crosses a wall.",
      "shot": 19,
      "at": 115.167,
      "seconds": 4.5
    },
    {
      "index": 22,
      "kind": "dialogue",
      "speaker": "unnamed_first_person_narrator",
      "text": "And oh! the sweetness of the air!",
      "shot": 20,
      "at": 121.583,
      "seconds": 2.92
    },
    {
      "index": 23,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The sky is open.",
      "shot": 20,
      "at": 125.203,
      "seconds": 1.59
    },
    {
      "index": 24,
      "kind": "narration",
      "speaker": "curate",
      "text": "The breeze moves the weed; the ruined world answers with light.",
      "shot": 21,
      "at": 128.917,
      "seconds": 4.68
    }
  ],
  "plan": "eada74c56171c22f"
}