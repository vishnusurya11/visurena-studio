  ],
  "lines": [
    {
      "index": 0,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "I watch London turn its streets into one northward flight beneath the bridges.",
      "shot": 0,
      "at": 0.25,
      "seconds": 5.3
    },
    {
      "index": 1,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The river crowds beneath the bridge, and the city presses toward every remaining road.",
      "shot": 1,
      "at": 6.667,
      "seconds": 6.08
    },
    {
      "index": 2,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The police lose coherence, then railway order follows; stations become traps for the fleeing crowd.",
      "shot": 2,
      "at": 13.875,
      "seconds": 7.24
    },
    {
      "index": 3,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Black vapour crosses the Thames and closes the bridges.",
      "shot": 3,
      "at": 22.542,
      "seconds": 3.9
    },
    {
      "index": 4,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Across England, survivors find each road narrowed by the same advancing disaster.",
      "shot": 4,
      "at": 27.667,
      "seconds": 5.64
    },
    {
      "index": 5,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The brother escapes the railway crush, takes a bicycle, and rides beyond the broken route.",
      "shot": 5,
      "at": 34.417,
      "seconds": 5.61
    },
    {
      "index": 6,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The wheel fails at Edgware, and the brother leaves the machine for the village.",
      "shot": 6,
      "at": 40.75,
      "seconds": 4.7
    },
    {
      "index": 7,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Food steadies him briefly; then fugitives gather while news stays distant.",
      "shot": 7,
      "at": 46.875,
      "seconds": 5.44
    },
    {
      "index": 8,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Beyond the stile, I find the brother beside screams and a trapped chaise.",
      "shot": 8,
      "at": 53.125,
      "seconds": 5.62
    },
    {
      "index": 9,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The brother drives the attackers from the chaise.",
      "shot": 9,
      "at": 60.25,
      "seconds": 4.25
    },
    {
      "index": 10,
      "kind": "dialogue",
      "speaker": "miss_elphinstone",
      "text": "Take this!",
      "shot": 10,
      "at": 67.625,
      "seconds": 1.17
    },
    {
      "index": 11,
      "kind": "dialogue",
      "speaker": "miss_elphinstone",
      "text": "Give me the reins.",
      "shot": 11,
      "at": 71.417,
      "seconds": 1.43
    },
    {
      "index": 12,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The chaise leaves the lane with the brother and women.",
      "shot": 11,
      "at": 73.547,
      "seconds": 4.17
    },
    {
      "index": 13,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Smoke and flame rise beyond the villas; the quiet lane meets a moving catastrophe.",
      "shot": 12,
      "at": 78.417,
      "seconds": 6.18
    },
    {
      "index": 14,
      "kind": "dialogue",
      "speaker": "mrs_elphinstone",
      "text": "Good heavens! What is this you are driving us into?",
      "shot": 13,
      "at": 86.125,
      "seconds": 3.23
    },
    {
      "index": 15,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The road becomes a human torrent, and one child falls beside the hedge.",
      "shot": 14,
      "at": 90.667,
      "seconds": 6.14
    },
    {
      "index": 16,
      "kind": "dialogue",
      "speaker": "narrators_brother",
      "text": "There may be a tap. We have no water. I dare not leave my people.",
      "shot": 15,
      "at": 98.208,
      "seconds": 4.46
    },
    {
      "index": 17,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Coins scatter; the brother reaches into a deadly crush.",
      "shot": 16,
      "at": 104.0,
      "seconds": 4.58
    },
    {
      "index": 18,
      "kind": "dialogue",
      "speaker": "narrators_brother",
      "text": "We must go that way.",
      "shot": 18,
      "at": 114.417,
      "seconds": 1.75
    },
    {
      "index": 19,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Past Barnet, thirst gathers fugitives at the brook, where water becomes another struggle.",
      "shot": 19,
      "at": 122.167,
      "seconds": 6.08
    },
    {
      "index": 20,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Two trains carry the same disorder north, their crowded roofs crossing the evening fields.",
      "shot": 20,
      "at": 129.667,
      "seconds": 6.02
    },
    {
      "index": 21,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "The party halts near East Barnet, while the day's violence leaves the road around them.",
      "shot": 21,
      "at": 137.125,
      "seconds": 5.0
    },
    {
      "index": 22,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Hunger and cold enter the halt; the brother keeps watch beside the women.",
      "shot": 22,
      "at": 143.458,
      "seconds": 4.84
    },
    {
      "index": 23,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Evening fugitives pass, extending the flight into darkness.",
      "shot": 23,
      "at": 149.708,
      "seconds": 5.32
    },
    {
      "index": 24,
      "kind": "narration",
      "speaker": "unnamed_first_person_narrator",
      "text": "Fugitives pass; the three stay awake in cold.",
      "shot": 25,
      "at": 160.458,
      "seconds": 3.87
    }
  ],
  "plan": "913a67d477b7895d"
}