    {
     "name_text": "Henry Jekyll",
     "presence": "mentioned",
     "role": "other",
     "para_first": 6
    },
    {
     "name_text": "Hyde",
     "presence": "mentioned",
     "role": "other",
     "para_first": 10
    },
    {
     "name_text": "Damon",
     "presence": "mentioned",
     "role": "other",
     "para_first": 9
    },
    {
     "name_text": "Pythias",
     "presence": "mentioned",
     "role": "other",
     "para_first": 9
    }
   ],
   "dialogue": [
    {
     "speaker_text": "Utterson",
     "addressee_text": "Lanyon",
     "attribution": "anaphoric",
     "para": 6,
     "notable_quote": "I suppose, Lanyon, … you and I must be the two oldest friends that Henry Jekyll has?"
    },
    {
     "speaker_text": "Lanyon",
     "addressee_text": "Utterson",
     "attribution": "explicit",
     "para": 7,
     "notable_quote": "I wish the friends were younger. But I suppose we are. And what of that? I see little of him now."
    },
    {
     "speaker_text": "Lanyon",
     "addressee_text": "Utterson",
     "attribution": "anaphoric",
     "para": 9,
     "notable_quote": "But it is more than ten years since Henry Jekyll became too fanciful for me. He began to go wrong, wrong in mind; and though of course I continue to take an interest in him for old sake’s sake, as they say, I see and I have seen devilish little of the man. Such unscientific balderdash … would have estranged Damon and Pythias."
    },
    {
     "speaker_text": "Utterson",
     "addressee_text": "Lanyon",
     "attribution": "anaphoric",
     "para": 10,
     "notable_quote": "Did you ever come across a protégé of his—one Hyde?"
    },
    {
     "speaker_text": "Lanyon",
     "addressee_text": "Utterson",
     "attribution": "anaphoric",
     "para": 11,
     "notable_quote": "Hyde? No. Never heard of him. Since my time."
    }
   ]
  },
  {
