    {
     "name_text": "Mr. Hyde",
     "presence": "mentioned",
     "role": "other",
     "para_first": 42
    }
   ],
   "dialogue": [
    {
     "speaker_text": "Utterson",
     "addressee_text": "Poole",
     "attribution": "anaphoric",
     "para": 42,
     "notable_quote": "I saw Mr. Hyde go in by the old dissecting room, Poole. Is that right, when Dr. Jekyll is from home?"
    },
    {
     "speaker_text": "Poole",
     "addressee_text": "Utterson",
     "attribution": "explicit",
     "para": 43,
     "notable_quote": "Quite right, Mr. Utterson, sir. Mr. Hyde has a key."
    },
    {
     "speaker_text": "Utterson",
     "addressee_text": "Poole",
     "attribution": "anaphoric",
     "para": 44,
     "notable_quote": "Your master seems to repose a great deal of trust in that young man, Poole, …"
    },
    {
     "speaker_text": "Poole",
     "addressee_text": "Utterson",
     "attribution": "anaphoric",
     "para": 45,
     "notable_quote": "Yes, sir, he does indeed. We have all orders to obey him."
    },
    {
     "speaker_text": "Utterson",
     "addressee_text": "Poole",
     "attribution": "anaphoric",
     "para": 46,
     "notable_quote": "I do not think I ever met Mr. Hyde?"
    },
    {
     "speaker_text": "Poole",
     "addressee_text": "Utterson",
     "attribution": "anaphoric",
     "para": 47,
     "notable_quote": "O, dear no, sir. He never dines here. Indeed we see very little of him on this side of the house; he mostly comes and goes by the laboratory."
    },
    {
     "speaker_text": "Utterson",
     "addressee_text": "Poole",
     "attribution": "anaphoric",
     "para": 48,
     "notable_quote": "Well, good-night, Poole."
    },
    {
     "speaker_text": "Poole",
     "addressee_text": "Utterson",
     "attribution": "anaphoric",
     "para": 49,
     "notable_quote": "Good-night, Mr. Utterson."
    }
   ]
